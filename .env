NODE_ENV=development
APP_NAME=food-delivery-backend
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PREFIX=api/v1
APP_CORS_ORIGINS=
SWAGGER_ENABLED=true

# Docker service name 'postgres' — not localhost
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/food_delivery
DB_ENABLE_QUERY_LOGS=false

# Docker service name 'redis' — not localhost
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=food-delivery

JWT_ACCESS_SECRET=IiQXuBCXJoMfL/Cbo2fZgvBOa5eSAdw96iw29wotShM=
JWT_REFRESH_SECRET=vl0psGEUWSTAt1FIUi/z+loda0P69fpMcZ2THY/kH4k=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=food-delivery-backend
JWT_AUDIENCE=food-delivery-platform

# S3 — stub mode (empty = no file uploads, app still starts)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# FCM — stub mode (empty CLIENT_EMAIL/PRIVATE_KEY = no push, app still starts)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Webhooks — empty = signature verification SKIPPED (safe for local dev)
PROVIDER_WEBHOOK_SIGNING_SECRET=
PAYMENT_WEBHOOK_SIGNING_SECRET=
REFUND_WEBHOOK_SIGNING_SECRET=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_PAYMENT_WEBHOOK_SIGNING_SECRET=
STRIPE_REFUND_WEBHOOK_SIGNING_SECRET=

APP_CORS_ORIGINS=http://localhost:3001