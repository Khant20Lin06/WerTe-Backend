{
  "name": "food-delivery-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node -r ./dist/instrumentation dist/main",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "verify:quick": "npm run prisma:validate && npm run prisma:generate && npm run typecheck",
    "verify": "npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm run test:unit && npm run test:integration",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f app",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:smoke": "node -e \"fetch('http://127.0.0.1:3000/api/v1/health/ready').then(async (response) => { const body = await response.text(); if (!response.ok) { console.error(body); process.exit(1); } console.log(body); }).catch((error) => { console.error(error); process.exit(1); })\"",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:prepare": "npm run prisma:validate && npm run prisma:generate",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "docs:export": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "docs:export:json": "npm run docs:export -- --format json",
    "docs:export:yaml": "npm run docs:export -- --format yaml",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed/seed.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register prisma/seed/seed-admin.ts",
    "seed:zones": "ts-node -r tsconfig-paths/register prisma/seed/seed-zones.ts",
    "db:reset:seed": "npm run prisma:migrate:reset && npm run seed"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/lib-storage": "^3.1057.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/client": "^5.21.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.21.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.8.1",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.21.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
